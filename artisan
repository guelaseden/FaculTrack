<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

if (array_slice($argv, 1) !== ['serve']) {
    fwrite(STDERR, "Usage: php artisan serve\n");
    exit(1);
}

$server = proc_open(
    [PHP_BINARY, '-S', '127.0.0.1:8000', '-t', __DIR__.'/public'],
    [STDIN, STDOUT, STDERR],
    $pipes
);
exit(is_resource($server) ? proc_close($server) : 1);
